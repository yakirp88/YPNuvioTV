new file mode 100644
index 0000000..f2a9fac
--- /dev/null
+++ b/.github/workflows/yp-introdb-build.yml
@@ -0,0 +1,47 @@
+name: YP IntroDB build
+on:
+  workflow_dispatch:
+    inputs:
+      publish_release:
+        description: Publish the APKs as a GitHub prerelease
+        type: boolean
+        default: true
+permissions:
+  contents: write
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    timeout-minutes: 40
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+      - uses: android-actions/setup-android@v3
+      - uses: gradle/actions/setup-gradle@v4
+      - name: Configure public services
+        run: |
+          printf '%s\n' "sdk.dir=$ANDROID_HOME" 'INTRODB_API_URL=https://api.introdb.app/' 'DOVI_NATIVE_ENABLED=false' > local.properties
+          chmod +x gradlew
+      - name: Reporting policy tests and APKs
+        run: >
+          ./gradlew -Pkotlin.compiler.execution.strategy=in-process
+          "-Dorg.gradle.jvmargs=-Xmx5120m -XX:MaxMetaspaceSize=768m -Dfile.encoding=UTF-8"
+          :app:testFullDebugUnitTest --tests com.nuvio.tv.data.introdb.IntroDbReportRulesTest
+          :app:assembleFullDebug --no-daemon --max-workers=1
+      - uses: actions/upload-artifact@v4
+        with:
+          name: YP-Nuvio-IntroDB-debug-apks
+          path: app/build/outputs/apk/full/debug/*.apk
+          if-no-files-found: error
+      - name: Publish APK download links
+        if: ${{ inputs.publish_release }}
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: >
+          gh release create "yp-introdb-${GITHUB_RUN_NUMBER}"
+          app/build/outputs/apk/full/debug/*.apk
+          --target "$GITHUB_SHA" --prerelease
+          --title "YP Nuvio IntroDB test build ${GITHUB_RUN_NUMBER}"
+          --notes-file YP-INTRODB-RELEASE-NOTES.md
